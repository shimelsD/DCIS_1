	<subDataset name="bn15n29" uuid="f10155bd-f2c0-4d53-bd88-61670f2b0e4f">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="bn15n29"/>
		<queryString language="SQL">
			<![CDATA[SELECT  dignosis,COUNT(dignosis) AS Total FROM patinet,diagnosis WHERE diagnosis.mrn=patinet.`MRN` AND patinet.`Gender`='male'
AND patinet.`Age` BETWEEN 15 AND 29 GROUP BY dignosis]]>
		</queryString>
		<field name="dignosis" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="dignosis"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="diagnosis"/>
		</field>
		<field name="Total" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.label" value="Total"/>
		</field>
	</subDataset>
